<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bar through roof triangles: live simulator</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@500;600&display=swap" rel="stylesheet">
<style>
:root{--paper:#F4F6F7;--sheet:#FFFFFF;--ink:#1F2A44;--ink-2:#55607A;--rule:#D5DBE2;--lumber:#C98A2B;--lumber-fill:#F3DDB4;--steel:#2F6FB0;--steel-fill:#C9DDF2;--stuck:#C9372C;--stuck-fill:#F6C9C4;--ok:#2E7D4F;--ok-bg:#E3F1E8;--bad-bg:#FBE6E3;--warn-bg:#FBF0D9;--warn:#8A5A0B;--roof:#DDE2E8;--dim:#5B4FC4;--spot:#BFE3D4}
@media (prefers-color-scheme: dark){:root{--paper:#14181F;--sheet:#1C222B;--ink:#E7ECF3;--ink-2:#A3AEC0;--rule:#323B48;--lumber:#E0A447;--lumber-fill:#5A4320;--steel:#7FB2E8;--steel-fill:#20405F;--stuck:#F07A6E;--stuck-fill:#5C2320;--ok:#7CCB9A;--ok-bg:#1E3A2A;--bad-bg:#45201D;--warn-bg:#41321A;--warn:#F0C27A;--roof:#2A323D;--dim:#A99FF2;--spot:#1F4A3B}}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font-family:Barlow,system-ui,sans-serif;font-size:16px;line-height:1.55}
.wrap{max-width:1080px;margin:0 auto;padding:26px 20px 48px}
header{border-bottom:2px solid var(--ink);padding-bottom:12px;margin-bottom:16px}
h1{font-family:"Barlow Condensed",Barlow,sans-serif;font-weight:600;font-size:34px;line-height:1.1;margin:0}
header p{margin:4px 0 0;color:var(--ink-2);max-width:68ch}
h2{font-family:"Barlow Condensed",Barlow,sans-serif;font-weight:600;font-size:22px;margin:0 0 8px}
.sheet{background:var(--sheet);border:1px solid var(--rule);border-radius:6px;padding:16px}
button{font:inherit;font-size:14px;color:var(--ink);background:transparent;border:1px solid var(--rule);border-radius:5px;padding:6px 12px;cursor:pointer}
button:hover{border-color:var(--ink-2)}
button.on{background:var(--ink);color:var(--sheet);border-color:var(--ink)}
button:focus-visible,input:focus-visible{outline:2px solid var(--steel);outline-offset:2px}
.barlen{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-bottom:16px}
.barlen .big{font-family:"Barlow Condensed",Barlow,sans-serif;font-size:40px;font-weight:600;min-width:120px;line-height:1}
.barlen input[type=range]{flex:1;min-width:200px;accent-color:var(--steel)}
.barlen input[type=number]{width:90px}
input[type=number]{font:inherit;font-size:15px;color:var(--ink);background:var(--paper);border:1px solid var(--rule);border-radius:5px;padding:6px 8px}
.row{display:flex;flex-wrap:wrap;align-items:center;gap:6px}
.ctrl{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-bottom:6px}
.prog{flex:1;min-width:80px;height:4px;background:var(--rule);border-radius:2px;overflow:hidden}
.prog div{height:100%;width:0;background:var(--steel)}
.ctrl label,.small{font-size:14px;color:var(--ink-2)}
#title{font-family:"Barlow Condensed",Barlow,sans-serif;font-size:22px;font-weight:500;margin:6px 0 2px}
svg{display:block;width:100%;height:auto}
svg text{font-family:Barlow,system-ui,sans-serif;font-size:13px;fill:var(--ink-2)}
svg text.dim{fill:var(--dim)} svg text.stuck{fill:var(--stuck);font-weight:600;font-size:14px}
#cap{padding:12px 14px;border-radius:5px;min-height:50px;background:var(--paper)}
#cap.bad{background:var(--bad-bg);color:var(--stuck)} #cap.fix{background:var(--ok-bg);color:var(--ok)}
.tabs{display:flex;gap:6px;margin-bottom:12px}
.try{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px 16px;margin-bottom:8px}
@media (max-width:760px){.try{grid-template-columns:minmax(0,1fr)}}
.try label{display:flex;flex-direction:column;font-size:13px;color:var(--ink-2)}
.try label span{color:var(--ink);font-weight:600}
.try input{accent-color:var(--steel)}
.grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:16px;margin-top:16px}
@media (max-width:820px){.grid{grid-template-columns:minmax(0,1fr)}}
table{width:100%;border-collapse:collapse;font-size:15px}
td{padding:6px 0;border-bottom:1px solid var(--rule);vertical-align:top}
td:last-child{text-align:right;font-weight:500;padding-left:12px}
#verdict{padding:12px 14px;border-radius:5px;margin-bottom:10px;font-size:16px}
#verdict.ok{background:var(--ok-bg);color:var(--ok)} #verdict.bad{background:var(--bad-bg);color:var(--stuck)} #verdict.warn{background:var(--warn-bg);color:var(--warn)}
.form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 14px}
.form label{display:flex;flex-direction:column;font-size:13px;color:var(--ink-2);gap:3px}
.form input{width:100%}
.err{color:var(--stuck);font-size:13px;min-height:18px;margin-top:6px}
.note{font-size:13px;color:var(--ink-2);margin-top:10px}
.hidden{display:none}
</style>
</head>
<body>
<div class="wrap">
<header>
  <h1>Bar through the roof triangles: live simulator</h1>
  <p>Change the bar length or any size below and everything updates: the animation, the angle to use, and all the key dimensions.</p>
</header>

<section class="sheet" aria-label="Bar length">
  <h2>Bar length</h2>
  <div class="barlen">
    <div class="big" id="lenBig">24 ft</div>
    <input type="range" id="lenSlider" min="4" max="40" step="0.5" aria-label="Bar length in feet">
    <label class="small">Custom (ft) <input type="number" id="lenNum" min="4" max="60" step="0.1"></label>
  </div>
  <div class="row" id="quick"></div>
  <div class="err" id="lenErr" role="alert"></div>
</section>

<section class="sheet" style="margin-top:16px" aria-label="Simulation">
  <div class="tabs"><button id="tabW" class="on">Walkthrough</button><button id="tabT">Try it yourself</button></div>
  <div id="walk">
    <div class="row" id="chips" style="margin-bottom:10px"></div>
    <div class="ctrl">
      <button id="pp">❚❚ Pause</button><button id="prev">‹ Prev</button><button id="next">Next ›</button><button id="rs">↺ Replay</button>
      <div class="prog"><div id="bar"></div></div>
    </div>
    <div id="title"></div>
  </div>
  <div id="tryBox" class="hidden">
    <div class="try">
      <label>Angle <span id="oAng"></span><input type="range" id="sAng" min="0" max="30" step="0.1"></label>
      <label>Bar height at T3 (center) <span id="oY"></span><input type="range" id="sY" step="0.1"></label>
      <label>Push (front end position) <span id="oX"></span><input type="range" id="sX" step="0.1"></label>
    </div>
    <div class="row" style="margin-bottom:8px"><button id="useBest">Use recommended angle</button><button id="goStart">Back to start</button><button id="goEnd">Pushed far enough</button></div>
  </div>
  <label class="small" style="display:inline-flex;gap:6px;align-items:center;margin:4px 0"><input type="checkbox" id="dims" checked> Show dimensions</label>
  <svg id="side" viewBox="0 0 900 380" role="img" aria-label="Side view of the bar and triangles"></svg>
  <div id="cap" aria-live="polite"></div>
</section>

<div class="grid">
  <section class="sheet">
    <h2>What to do with this bar</h2>
    <div id="verdict"></div>
    <table id="tbl"></table>
  </section>
  <section class="sheet">
    <h2>Looking through a triangle</h2>
    <svg id="front" viewBox="0 0 420 230" role="img" aria-label="Triangle cross-section"></svg>
    <h2 style="margin-top:12px">Roof and triangle sizes</h2>
    <div class="form">
      <label>Bar size, square (in)<input type="number" id="iT" step="0.25" min="1" max="24"></label>
      <label>Spacing between triangles (ft)<input type="number" id="iS" step="0.5" min="2" max="30"></label>
      <label>Number of triangles<input type="number" id="iN" step="1" min="4" max="12"></label>
      <label>Triangle height (in)<input type="number" id="iH" step="0.5" min="8" max="120"></label>
      <label>Triangle base width (in)<input type="number" id="iW" step="1" min="12" max="480"></label>
      <label>Member thickness (in)<input type="number" id="iC" step="0.25" min="0.5" max="12"></label>
      <label>Open space below triangles (in)<input type="number" id="iF" step="1" min="6" max="240"></label>
      <label style="justify-content:flex-end"><button id="reset" type="button">Reset to defaults</button></label>
    </div>
    <div class="err" id="err" role="alert"></div>
    <p class="note">Defaults: triangles 30" high, 10 ft apart, bar 5" × 5". The 96" base width, 3.5" member thickness, and 40" of open space below are assumptions; enter your real measurements. The loading spot is the gap between T2 and T3. The bar is treated as straight and stiff, fed along one straight line; real bars sag a little, so keep some margin.</p>
  </section>
</div>
</div>

<script>
const DEF={L:288,T:5,S:120,N:6,H:30,W:96,C:3.5,F:40};
let D={...DEF},G={},S=[];
const $=id=>document.getElementById(id),NS='http://www.w3.org/2000/svg';
const css=v=>getComputedStyle(document.documentElement).getPropertyValue(v).trim();
function el(p,t,a,x){const e=document.createElementNS(NS,t);for(const k in a)e.setAttribute(k,a[k]);if(x!=null)e.textContent=x;p.appendChild(e);return e}
const r1=v=>Math.round(v*10)/10;
const len=v=>{if(v>=24){const ft=v/12;return (Math.abs(ft-Math.round(ft))<0.05?Math.round(ft):r1(ft))+' ft'}return r1(v)+'"'};
const RAD=Math.PI/180;

function geo(d){const AL=Math.atan(2*d.H/d.W),OUT=d.H*(1-2*(d.T/2)/d.W),IN=OUT-d.C/Math.cos(AL);
  return{AL,OUT,IN,X2:d.S,X3:2*d.S,ROW:(d.N-1)*d.S,fits:IN-d.C>d.T,x0:2*d.S-d.S/3}}
function slack(d,g,th,y0,useFloor){
  const t=Math.tan(th*RAD),c=Math.cos(th*RAD),hv=(d.T/2)/c,y=x=>y0+(x-g.X3)*t;
  const xa=g.x0-d.L*c,xb=Math.max(g.X2+6+d.L*c,g.x0);let s=1e9;
  for(let i=0;i<d.N;i++){const xi=i*d.S;if(xi<xa||xi>xb)continue;
    if(xi<=g.X2)s=Math.min(s,-(y(xi)+hv));else s=Math.min(s,y(xi)-hv-d.C,g.IN-(y(xi)+hv))}
  const xr=Math.min(xb,g.ROW);if(xr>0)s=Math.min(s,g.OUT-(y(xr)+hv));
  if(useFloor)s=Math.min(s,y(xa)-hv+d.F);
  return{s,low:-(y(xa)-hv),xa,xb}}
function solve(d,useFloor,coarse){
  const g=geo(d);if(!g.fits)return{g,none:true};
  if(d.L<=d.S-6)return{g,straight:true};
  const st=coarse?0.1:0.05,sy=coarse?0.25:0.1;let best=null,lo=null,hi=null;
  for(let th=0.1;th<=30;th+=st){let m=-1e9,my=0;
    for(let y0=d.C+d.T/2;y0<=g.IN-d.T/2+1e-9;y0+=sy){const r=slack(d,g,th,y0,useFloor).s;if(r>m){m=r;my=y0}}
    if(m>=0){if(lo===null)lo=th;hi=th}
    if(!best||m>best.s)best={th,y0:my,s:m}}
  return{g,lo,hi,best,ok:lo!==null,det:best?slack(d,g,best.th,best.y0,useFloor):null}}
function maxLen(){
  if(!geo(D).fits)return 0;let a=D.S-6,b=720;
  const ok=L=>{const r=solve({...D,L},true,true);return r.straight||r.ok};
  if(ok(b))return b;for(let i=0;i<13;i++){const m=(a+b)/2;if(ok(m))a=m;else b=m}return a}

function compute(){
  const sol=solve(D,true,false);G={...sol.g,sol};
  G.straight=!!sol.straight;G.ok=G.straight||!!sol.ok;
  G.noFloor=(!G.straight&&!sol.ok&&!sol.none)?solve(D,false,false):null;
  G.maxL=maxLen();
  const lvl=D.C+D.T/2;
  let k=Math.floor((D.L-12)/D.S)+1;const avail=D.N-2;if(k>avail)k=avail;
  if(k>=2){const ov=(D.L-(k-1)*D.S)/2;G.finalTail=G.X3-ov}else{G.finalTail=G.X3-D.L/2}
  G.finalTip=G.finalTail+D.L;G.k=Math.max(1,k);
  G.sup=[];for(let i=0;i<D.N;i++){const x=i*D.S;if(x>=G.finalTail-0.01&&x<=G.finalTip+0.01)G.sup.push(i+1)}
  if(sol.best){const b=sol.best,c=Math.cos(b.th*RAD);G.b=b.th;G.y0=b.y0;G.endTip=G.X2+6+D.L*c;
    const tl=G.endTip-D.L*c,ytl=b.y0+(tl-G.X3)*Math.tan(b.th*RAD);G.liftBack=lvl-ytl;G.pushDist=(G.endTip-G.x0)/c}
}

let P={tipX:0,tipY:0,th:0,lift:0},showD=true,stuck=[],mode='ok',tryMode=false;
const tn=()=>Math.tan(P.th*RAD),hv=()=>(D.T/2)/Math.cos(P.th*RAD);
const tail=()=>P.tipX-D.L*Math.cos(P.th*RAD),yAt=x=>P.tipY-(P.tipX-x)*tn();
const line=(th,x,y0)=>y0+(x-G.X3)*Math.tan(th*RAD);
function hits(){const h=[],tl=tail(),v=hv();
  for(let i=0;i<D.N;i++){const xi=i*D.S,xs=[xi-0.75,xi,xi+0.75].filter(x=>x>=tl&&x<=P.tipX);if(!xs.length)continue;
    let top=-1e9,bot=1e9;xs.forEach(x=>{top=Math.max(top,yAt(x)+v);bot=Math.min(bot,yAt(x)-v)});
    if(top>0.01&&bot<D.C-0.01)h.push({x:xi,y:D.C/2,m:'the bottom member of T'+(i+1)});
    if(top>G.IN+0.01)h.push({x:xi,y:G.IN,m:'the sloped top member of T'+(i+1)})}
  for(let x=Math.max(tl,0);x<=Math.min(P.tipX,G.ROW);x+=1){let nr=false;for(let i=0;i<D.N;i++)if(Math.abs(x-i*D.S)<1.5)nr=true;
    if(!nr&&yAt(x)+v>G.OUT){h.push({x,y:G.OUT,m:'the roof boards'});break}}
  for(let x=tl;x<=P.tipX;x+=2){if(yAt(x)-v<-D.F-0.01){h.push({x,y:-D.F,m:'the floor (not enough room below)'});break}}
  return h}

function dimH(s,x1,x2,y,lab){const c=css('--dim');el(s,'line',{x1,x2,y1:y,y2:y,stroke:c});[x1,x2].forEach(x=>el(s,'line',{x1:x,x2:x,y1:y-5,y2:y+5,stroke:c}));el(s,'text',{x:(x1+x2)/2,y:y-7,'text-anchor':'middle',class:'dim'},lab)}
function dimV(s,x,y1,y2,lab,side){const c=css('--dim');el(s,'line',{x1:x,x2:x,y1,y2,stroke:c});[y1,y2].forEach(y=>el(s,'line',{x1:x-5,x2:x+5,y1:y,y2:y,stroke:c}));if(lab)el(s,'text',{x:side==='l'?x-7:x+7,y:(y1+y2)/2+4,'text-anchor':side==='l'?'end':'start',class:'dim'},lab)}

function view(){const xmin=Math.min(-D.S,G.X2-D.L-20),xmax=Math.max(G.ROW+30,G.finalTip+10);
  const sx=720/(xmax-xmin),ymin=-D.F-8,ymax=D.H+8,sy=260/(ymax-ymin);
  return{xmin,xmax,sx,sy,ymin,ymax,px:x=>30+(x-xmin)*sx,py:y=>320-(y-ymin)*sy}}
function draw(){
  const s=$('side');s.innerHTML='';const V=view(),px=V.px,py=V.py;
  const cp=el(el(s,'defs',{}),'clipPath',{id:'clp'});el(cp,'rect',{x:0,y:py(V.ymax),width:900,height:py(V.ymin)-py(V.ymax)});
  el(s,'rect',{x:px(0),y:py(V.ymax),width:px(G.ROW)-px(0),height:Math.max(0,py(G.OUT)-py(V.ymax)),fill:css('--roof')});
  el(s,'text',{x:px(G.ROW/2),y:py(V.ymax)+16,'text-anchor':'middle'},'roof');
  el(s,'rect',{x:px(G.X2)+4,y:py(-D.F)-3,width:px(G.X3)-px(G.X2)-8,height:12,fill:css('--spot'),rx:2});
  el(s,'text',{x:(px(G.X2)+px(G.X3))/2,y:py(-D.F)+26,'text-anchor':'middle'},'loading spot');
  el(s,'line',{x1:20,x2:880,y1:py(-D.F),y2:py(-D.F),stroke:css('--ink-2'),'stroke-dasharray':'5 4'});
  el(s,'text',{x:24,y:py(-D.F)-8},'floor below (open)');
  for(let i=0;i<D.N;i++){const X=px(i*D.S)-4,red=stuck.some(h=>Math.abs(h.x-i*D.S)<1);
    const f=red?css('--stuck-fill'):css('--lumber-fill'),st=red?css('--stuck'):css('--lumber');
    el(s,'rect',{x:X,y:py(D.C),width:8,height:py(0)-py(D.C),fill:f,stroke:st});
    if(G.IN<G.OUT)el(s,'rect',{x:X,y:py(G.OUT),width:8,height:Math.max(0,py(G.IN)-py(G.OUT)),fill:f,stroke:st});
    el(s,'text',{x:px(i*D.S),y:py(0)+17,'text-anchor':'middle'},'T'+(i+1))}
  const tl=tail(),v=hv(),top=[],bot=[];
  for(let k=0;k<=40;k++){const x=tl+(P.tipX-tl)*k/40,y=yAt(x);top.push(px(x)+','+py(y+v));bot.unshift(px(x)+','+py(y-v))}
  el(s,'polygon',{points:top.concat(bot).join(' '),fill:stuck.length?css('--stuck-fill'):css('--steel-fill'),stroke:stuck.length?css('--stuck'):css('--steel'),'stroke-width':1.2,'clip-path':'url(#clp)'});
  if(showD){for(let i=0;i<D.N-1;i++)dimH(s,px(i*D.S),px((i+1)*D.S),28,len(D.S));
    const R=px(G.ROW);dimV(s,R+16,py(0),py(D.C),len(D.C));dimV(s,R+16,py(D.C),py(G.IN),r1(G.IN-D.C)+'" open');dimV(s,R+16,py(-D.F),py(0),len(D.F)+' below');
    el(s,'line',{x1:R-6,x2:R+80,y1:py(D.H),y2:py(D.H),stroke:css('--dim'),'stroke-dasharray':'3 3'});dimV(s,R+76,py(0),py(D.H),'');
    el(s,'text',{x:R+82,y:py(D.H)-5,class:'dim'},len(D.H)+' peak');
    const mx=(tl+P.tipX)/2,my=yAt(mx)+v;el(s,'text',{x:Math.max(110,Math.min(700,px(mx))),y:py(my)-9,'text-anchor':'middle',class:'dim'},'bar '+len(D.L)+' long, '+len(D.T)+' × '+len(D.T));
    const ty=yAt(tl)+v;if(ty<-1)el(s,'text',{x:Math.max(26,Math.min(px(tl),640)),y:Math.min(py(ty)+18,py(-D.F)-22),class:'dim'},'back end '+Math.round(-ty)+'" below triangles');
    if(Math.abs(P.th)>0.2){const X=px(P.tipX),Y=py(yAt(P.tipX));el(s,'text',{x:Math.min(X+8,820),y:Y-10,class:'dim'},P.th.toFixed(1)+'°')}}
  if(P.lift){const X=px(tl+4),Y=py(yAt(tl+4)-v),c=css('--ok');el(s,'line',{x1:X,y1:Y+30,x2:X,y2:Y+5,stroke:c,'stroke-width':3});el(s,'polygon',{points:`${X-6},${Y+12} ${X+6},${Y+12} ${X},${Y+2}`,fill:c});el(s,'text',{x:X+10,y:Y+28,fill:c},'lift back end')}
  stuck.forEach((h,j)=>{el(s,'circle',{cx:px(h.x),cy:py(h.y),r:11,fill:'none',stroke:css('--stuck'),'stroke-width':3});if(j===0)el(s,'text',{x:Math.min(px(h.x)+14,760),y:py(h.y)-14,class:'stuck'},'Stuck here')});
  el(s,'text',{x:30,y:372},'Side view. Height is stretched about '+Math.round(V.sy/V.sx)+'× so the triangles are visible; labeled sizes are real.')}

function front(){const f=$('front');f.innerHTML='';const fs=Math.min(320/D.W,150/(D.H+2)),fx=x=>200+x*fs,fy=y=>180-y*fs;
  const ib=(D.W/2)*(1-D.C/D.H)-D.C/Math.sin(G.AL),ia=D.H-D.C/Math.cos(G.AL);
  el(f,'polygon',{points:`${fx(-D.W/2)},${fy(0)} ${fx(D.W/2)},${fy(0)} ${fx(0)},${fy(D.H)}`,fill:css('--lumber-fill'),stroke:css('--lumber')});
  if(ib>0&&ia>D.C)el(f,'polygon',{points:`${fx(-ib)},${fy(D.C)} ${fx(ib)},${fy(D.C)} ${fx(0)},${fy(ia)}`,fill:css('--sheet'),stroke:css('--lumber')});
  el(f,'rect',{x:fx(-D.T/2),y:fy(D.C+D.T),width:D.T*fs,height:D.T*fs,fill:G.fits?css('--steel-fill'):css('--stuck-fill'),stroke:G.fits?css('--steel'):css('--stuck')});
  if(showD){dimH(f,fx(-D.W/2),fx(D.W/2),fy(0)+30,len(D.W)+' base');dimV(f,fx(D.W/2)+10,fy(0),fy(D.H),len(D.H)+' high');
    dimV(f,fx(-D.W/2)+40,fy(0),fy(D.C),len(D.C)+' member','l');
    el(f,'line',{x1:fx(D.T/2)+3,x2:fx(D.T/2)+40,y1:fy(D.C+D.T/2),y2:fy(D.C+D.T/2)-26,stroke:css('--dim')});
    el(f,'text',{x:fx(D.T/2)+44,y:fy(D.C+D.T/2)-28,class:'dim'},len(D.T)+' bar')}}

function results(){
  const v=$('verdict'),sol=G.sol,rows=[];const supTxt=G.sup.length?('T'+G.sup[0]+(G.sup.length>1?'–T'+G.sup[G.sup.length-1]:'')):'—';
  const ovB=(G.X3-G.finalTail),last=G.sup.length?(G.sup[G.sup.length-1]-1)*D.S:G.finalTip,ovF=G.finalTip-last;
  if(!G.fits){v.className='bad';v.textContent='The '+len(D.T)+' bar is taller than the '+r1(G.IN-D.C)+'" opening inside the triangles, so it can\'t pass through at all.'}
  else if(G.straight){v.className='ok';v.textContent='This bar is shorter than the '+len(D.S)+' gap. Lift it straight up into the gap, level, then push it along. No angle needed.'}
  else if(sol.ok){v.className='ok';v.textContent='Feed it in at about '+r1(G.b)+'°, front end first. Anything from '+r1(sol.lo)+'° to '+r1(sol.hi)+'° works.'}
  else if(G.noFloor&&G.noFloor.ok){v.className='warn';v.textContent='The angle would work, but there isn\'t enough room below. You need about '+Math.ceil(G.noFloor.det.low+2)+'" of open space under the triangles; you have '+len(D.F)+'.'}
  else{v.className='bad';v.textContent='No straight feed works for a '+len(D.L)+' bar from this gap. The longest bar that works here is about '+r1(G.maxL/12)+' ft. Load it from the open end of the row, or use shorter pieces joined in place.'}
  rows.push(['Bar',len(D.L)+' long, '+len(D.T)+' × '+len(D.T)]);
  if(G.fits&&!G.straight&&sol.best){
    rows.push(['Angle to use',r1(G.b)+'°']);
    rows.push(['Safe angle range',sol.ok?r1(sol.lo)+'° to '+r1(sol.hi)+'°':'none']);
    rows.push(['Rise per 10 ft at that angle',r1(120*Math.tan(G.b*RAD))+'"']);
    rows.push(['Bar bottom above T3\'s bottom member',r1(G.y0-D.T/2-D.C)+'"']);
    rows.push(['Tightest clearance on the way',sol.best.s>=0?r1(sol.best.s)+'"':'none (it hits)']);
    rows.push(['Back end at the start',Math.round(G.sol.det.low)+'" below the triangles']);
    rows.push(['Push distance along the angle',r1(G.pushDist/12)+' ft']);
    rows.push(['Then lift the back end',Math.round(G.liftBack)+'"'])}
  if(G.fits)rows.push(['Final resting spot',supTxt+(G.sup.length<2?' (too short to span two triangles, needs support)':'')]);
  if(G.fits&&G.sup.length)rows.push(['Overhang behind / ahead',r1(ovB/12)+' ft / '+r1(ovF/12)+' ft']);
  rows.push(['Opening inside the triangle',r1(Math.max(0,G.IN-D.C))+'" tall']);
  rows.push(['Longest bar from this gap','about '+r1(G.maxL/12)+' ft']);
  $('tbl').innerHTML=rows.map(r=>`<tr><td>${r[0]}</td><td>${r[1]}</td></tr>`).join('')}

function build(){
  const fl=-D.F+D.T/2+1,mid=(G.X2+G.X3)/2,x0=G.x0,lvl=D.C+D.T/2,sol=G.sol;
  const sup=G.sup.length?'T'+G.sup.join(', T'):'T3';
  const done='Done: the bar rests on '+sup+'.';
  if(!G.fits){S=[{t:'Bar too big',s:[{set:{tipX:mid+D.L/2,tipY:fl,th:0,lift:0}},{tween:{tipY:lvl},ms:2000,c:'Lifting into place…'},{hold:4000,c:'The bar is taller than the opening inside the triangles.',m:'bad'}]}]}
  else if(G.straight){S=[{t:'Lift straight up, then push',s:[{set:{tipX:mid+D.L/2,tipY:fl,th:0,lift:0}},{hold:1800,c:'This '+len(D.L)+' bar is shorter than the '+len(D.S)+' gap, so it fits between the triangles.'},{tween:{tipY:lvl},ms:2200,c:'Lift it straight up, level, to the height of the bottom members.',m:'fix'},{move:G.finalTip,c:'Then push it along to where you want it.',m:'fix'},{hold:4000,c:done+(G.sup.length<2?' It is too short to span two triangles, so it needs extra support.':''),m:'fix'}]}]}
  else{
    const b=G.b,lo=sol.ok?sol.lo:b,hi=sol.ok?sol.hi:b,flat=Math.max(0.3,lo*0.5),steep=hi+2.5;
    S=[{t:'1. The problem',s:[{set:{tipX:mid+D.L/2,tipY:fl,th:0,lift:0}},{hold:2200,c:'Loading spot: the '+len(D.S)+' gap between T2 and T3. The '+len(D.L)+' bar starts on the floor below.'},{tween:{tipY:lvl},ms:2500,c:'Lifting it straight up, level…'},{hold:3000,c:'The bar is longer than the gap, so it can\'t go straight up.',m:'bad'},{hold:1800,c:'It has to go in at an angle, front end first.',m:'fix'}]},
    {t:'2. Too flat ('+r1(flat)+'°)',s:[{set:{tipX:x0,tipY:fl,th:0,lift:0}},{hold:700,c:'Lifting the front end at a flat '+r1(flat)+'°…'},{tween:{th:flat,tipY:()=>line(flat,x0,lvl+0.5)},ms:2200},{move:G.X3+D.S/2,c:'…and pushing forward.'},{hold:3000,c:'Too flat: the back part can\'t stay under the triangle behind.',m:'bad'},{tween:{th:0,tipY:fl,tipX:x0},nohit:1,ms:1300,c:'Fix: use a steeper angle, at least '+r1(lo)+'°.',m:'fix'},{hold:1200,m:'fix'}]},
    {t:'3. Too steep ('+r1(steep)+'°)',s:[{set:{tipX:x0,tipY:fl,th:0,lift:0}},{hold:700,c:'Lifting the front end at a steep '+r1(steep)+'°…'},{tween:{th:steep,tipY:()=>line(steep,x0,lvl+0.5)},ms:2200},{move:G.ROW+D.S,c:'…and pushing forward along that angle.'},{hold:3000,c:'Too steep: at this angle the bar can\'t fit between the floor, the triangles ahead, and the roof.',m:'bad'},{move:()=>P.tipX-12,c:'Fix: pull it back about a foot…',m:'fix'},{tween:{th:b,tipY:()=>line(b,P.tipX,G.y0)},ms:1800,c:'…and lower the angle to about '+r1(b)+'°.',m:'fix'},{move:G.endTip,c:'Now it slides through.',m:'fix'},{hold:1500,m:'fix'}]},
    {t:'4. The right way ('+r1(b)+'°)',s:[{set:{tipX:x0,tipY:fl,th:0,lift:0}},{hold:700,c:'Lift the front end into the gap at about '+r1(b)+'°. Keep the back end low, about '+Math.round(sol.det.low)+'" below the triangles.',m:'fix'},{tween:{th:b,tipY:()=>line(b,x0,G.y0)},ms:2400},{move:G.endTip,c:'Push forward '+r1(G.pushDist/12)+' ft along the angle, until the back end comes up into the gap.',m:'fix'},{tween:{lift:1},ms:300,c:'Lift the back end about '+Math.round(G.liftBack)+'" and let the front come down until the bar is level.',m:'fix'},{tween:{th:0,tipY:lvl},ms:2400},{tween:{lift:0},ms:200},{move:G.finalTip,c:'Slide it level to its final spot.',m:'fix'},G.ok?{hold:4500,c:done,m:'fix'}:{hold:4500,c:'Even the best angle ('+r1(b)+'°) gets stuck: this bar is too long to load from this gap. The longest that works is about '+r1(G.maxL/12)+' ft.',m:'bad'}]}]}
  const ch=$('chips');ch.innerHTML='';S.forEach((sc,i)=>{const bt=document.createElement('button');bt.textContent=sc.t;bt.onclick=()=>go(i);ch.appendChild(bt)})}

let si=0,st=0,t=0,from=null,to={},playing=true,last=0;
function setCap(c,m){if(c!=null)$('cap').textContent=c;if(m)mode=m;$('cap').className=mode==='bad'?'bad':mode==='fix'?'fix':''}
function go(i){si=Math.min(i,S.length-1);st=0;t=0;from=null;stuck=[];mode='ok';$('title').textContent=S[si].t;
  [...$('chips').children].forEach((b,k)=>b.classList.toggle('on',k===si));setCap('',null);if(!playing)toggle()}
function nextStep(){st++;t=0;from=null}
function onHit(h,steps){stuck=h;nextStep();while(st<steps.length&&!steps[st].hold)st++;const nx=steps[st];setCap('Stuck: the bar hits '+h[0].m+'. '+(nx&&nx.c&&nx.m==='bad'?nx.c:''),'bad');if(nx&&nx.m!=='bad')st++}
function tick(now){const dt=Math.min(50,now-(last||now));last=now;
  if(playing&&!tryMode&&S.length){const steps=S[si].s;
    if(st>=steps.length){if(si<S.length-1)go(si+1);else toggle()}
    else{const s=steps[st];
      if(!from&&t===0&&(s.c!=null||s.m)&&!(s.hold&&mode==='bad'&&s.m==='bad'))setCap(s.c,s.m||(s.hold?mode:'ok'));
      if(s.set){Object.assign(P,s.set);stuck=[];nextStep()}
      else if(s.hold){t+=dt;if(t>=s.hold)nextStep()}
      else if(s.tween){if(!from){from={};to={};for(const k in s.tween){from[k]=P[k];to[k]=typeof s.tween[k]==='function'?s.tween[k]():s.tween[k]}stuck=[]}
        const prev={...P};t+=dt;const f=Math.min(1,t/s.ms);for(const k in to)P[k]=from[k]+(to[k]-from[k])*f;
        const h=s.nohit?[]:hits();if(h.length){Object.assign(P,prev);onHit(h,steps)}else if(f>=1)nextStep()}
      else if(s.move!=null){if(!from){const tg=typeof s.move==='function'?s.move():s.move;from={tg,dir:tg>=P.tipX?1:-1};stuck=[]}
        const v=0.075*dt*from.dir,a=P.th*RAD;P.tipX+=v*Math.cos(a);P.tipY+=v*Math.sin(a);
        const h=hits();if(h.length){P.tipX-=v*Math.cos(a);P.tipY-=v*Math.sin(a);onHit(h,steps)}
        else if((from.dir>0&&P.tipX>=from.tg)||(from.dir<0&&P.tipX<=from.tg))nextStep()}}
    const tot=S[si].s.length;$('bar').style.width=(Math.min(st,tot)/tot*100)+'%';draw()}
  requestAnimationFrame(tick)}
function toggle(){playing=!playing;$('pp').textContent=playing?'❚❚ Pause':'▶ Play'}
$('pp').onclick=()=>{if(!playing&&si===S.length-1&&st>=S[si].s.length)go(0);toggle()};
$('prev').onclick=()=>go(Math.max(0,si-1));$('next').onclick=()=>go(Math.min(S.length-1,si+1));$('rs').onclick=()=>go(si);
$('dims').onchange=e=>{showD=e.target.checked;front();draw()};

function setTryRanges(){const V=view();$('sY').min=r1(-D.F);$('sY').max=r1(D.H);$('sX').min=r1(G.X2/12);$('sX').max=r1(V.xmax/12)}
function tryUpdate(){const a=+$('sAng').value,y0=+$('sY').value,x=+$('sX').value*12;
  P.th=a;P.tipX=x;P.tipY=line(a,x,y0);P.lift=0;
  $('oAng').textContent=a.toFixed(1)+'°';$('oY').textContent=y0.toFixed(1)+'"';$('oX').textContent=r1(x/12)+' ft from T1';
  const h=hits();stuck=h;
  if(h.length)setCap('Stuck: the bar hits '+h.map(z=>z.m).join(' and ')+'.','bad');
  else{const tl=tail();const msg=tl>G.X2+0.75?'Clear. The back end is past T2, in the gap. From here you can lift it level.':'Clear so far. Keep pushing until the back end comes up past T2 (it is '+r1((G.X2-tl)/12)+' ft behind it now).';setCap(msg,'fix')}
  draw()}
function tryBest(){const b=G.straight?0:(G.b||5),y0=G.straight?D.C+D.T/2:(G.y0||D.C+D.T/2+2);$('sAng').value=r1(b);$('sY').value=r1(y0);$('sX').value=r1(G.x0/12);tryUpdate()}
['sAng','sY','sX'].forEach(id=>$(id).addEventListener('input',tryUpdate));
$('useBest').onclick=()=>{const x=$('sX').value;tryBest();$('sX').value=x;tryUpdate()};
$('goStart').onclick=()=>{$('sX').value=r1(G.x0/12);tryUpdate()};
$('goEnd').onclick=()=>{$('sX').value=r1((G.endTip||G.finalTip)/12);tryUpdate()};
function setTab(t){tryMode=t;$('tabT').classList.toggle('on',t);$('tabW').classList.toggle('on',!t);$('walk').classList.toggle('hidden',t);$('tryBox').classList.toggle('hidden',!t);
  if(t){setTryRanges();tryBest()}else go(si)}
$('tabW').onclick=()=>setTab(false);$('tabT').onclick=()=>setTab(true);

function refresh(keepScene){compute();build();front();results();
  if(tryMode){setTryRanges();tryUpdate()}else go(keepScene?si:S.length-1)}
let tmr=null;const later=f=>{clearTimeout(tmr);tmr=setTimeout(f,180)};
function setLen(ft,src){D.L=ft*12;$('lenBig').textContent=r1(ft)+' ft';if(src!=='s')$('lenSlider').value=Math.min(40,Math.max(4,ft));if(src!=='n')$('lenNum').value=r1(ft);
  [...$('quick').children].forEach(b=>b.classList.toggle('on',+b.dataset.ft===r1(ft)));later(()=>refresh(true))}
[10,15,20,24,30,36].forEach(ft=>{const b=document.createElement('button');b.textContent=ft+' ft';b.dataset.ft=ft;b.onclick=()=>{$('lenErr').textContent='';setLen(ft)};$('quick').appendChild(b)});
$('lenSlider').addEventListener('input',e=>{$('lenErr').textContent='';setLen(+e.target.value,'s')});
$('lenNum').addEventListener('input',e=>{const v=parseFloat(e.target.value);if(!isFinite(v)||v<4||v>60){$('lenErr').textContent='Enter a length between 4 and 60 ft.';return}$('lenErr').textContent='';setLen(v,'n')});

const fields={iT:['T',1],iS:['S',12],iN:['N',1],iH:['H',1],iW:['W',1],iC:['C',1],iF:['F',1]};
function fill(){for(const id in fields){const[k,m]=fields[id];$(id).value=r1(D[k]/m)}}
Object.keys(fields).forEach(id=>$(id).addEventListener('input',()=>{
  const nd={...D};for(const f in fields){const[k,m]=fields[f],inp=$(f),v=parseFloat(inp.value);
    if(!isFinite(v)||v<+inp.min||v>+inp.max){$('err').textContent='Enter a number between '+inp.min+' and '+inp.max+' for "'+inp.parentElement.firstChild.textContent.trim()+'".';return}
    nd[k]=k==='N'?Math.round(v):v*m}
  if(nd.C*2>=nd.H){$('err').textContent='Member thickness must be less than half the triangle height.';return}
  $('err').textContent='';D=nd;later(()=>refresh(true))}));
$('reset').onclick=()=>{const L=D.L;D={...DEF,L};$('err').textContent='';fill();refresh(true)};
window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change',()=>{front();draw()});
fill();setLen(24);compute();build();front();results();go(S.length-1);requestAnimationFrame(tick);
</script>
</body>
